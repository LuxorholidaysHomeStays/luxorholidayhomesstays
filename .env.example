# Frontend environment template. Use local secret storage; never commit real credentials.
VITE_API_BASE_URL=http://localhost:9000
VITE_RAZORPAY_KEY=your_razorpay_public_key
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_OTP_FIREBASE_API_KEY=your_otp_firebase_api_key
VITE_OTP_FIREBASE_APP_ID=your_otp_firebase_app_id
VITE_OTP_FIREBASE_AUTH_DOMAIN=your-otp-project.firebaseapp.com
VITE_OTP_FIREBASE_MESSAGING_SENDER_ID=your_otp_sender_id
VITE_OTP_FIREBASE_PROJECT_ID=your_otp_firebase_project_id
VITE_OTP_FIREBASE_STORAGE_BUCKET=your-otp-project.firebasestorage.app
